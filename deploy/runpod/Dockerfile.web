FROM node:22-bookworm-slim AS assets
WORKDIR /web
COPY web/package*.json ./
RUN npm ci --omit=dev

FROM python:3.11-slim-bookworm
WORKDIR /opt/mapmaker
COPY pyproject.toml uv.lock ./
COPY mapmaker mapmaker
COPY web web
COPY --from=assets /web/node_modules web/node_modules
RUN pip install --no-cache-dir uv==0.8.22 && uv sync --frozen --no-dev --extra remote
ENV MAPMAKER_BACKEND=runpod PORT=8080 PORT_HEALTH=8081 PYTHONUNBUFFERED=1
EXPOSE 8080 8081
ENTRYPOINT ["/opt/mapmaker/.venv/bin/python", "-m", "mapmaker.cloud_web"]
